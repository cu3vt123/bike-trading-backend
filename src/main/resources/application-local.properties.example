# Sao chép file này thành: src/main/resources/application-local.properties
# (file đó đã .gitignore — KHÔNG commit file local lên Git).
#
# BẢO MẬT: Không dán block chứa mật khẩu MySQL hoặc app.jwt-secret lên GitHub / Discord công khai.
# Chỉ điền secret thật trên máy bạn hoặc trao qua kênh riêng.
#
# Chạy với profile local:
#   .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=local"
#   IntelliJ: Active profiles = local
#
# ---------------------------------------------------------------------------
# MySQL (sửa url / user / password cho đúng máy bạn)
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/quydu_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your_mysql_password_here

# Tuỳ chọn: thêm createDatabaseIfNotExist=true nếu cần tự tạo DB, ví dụ:
# spring.datasource.url=jdbc:mysql://localhost:3306/quydu_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true

# ---------------------------------------------------------------------------
# JWT — tên property trong Bespring phải là app.jwt-secret (xem JwtTokenProvider)
# Đủ dài, ngẫu nhiên; đổi secret → token cũ hết hiệu lực
# ---------------------------------------------------------------------------
app.jwt-secret=CHANGE_ME_to_a_long_random_secret_at_least_32_bytes

# ---------------------------------------------------------------------------
# VNPAY sandbox (TEST — credential demo công khai của VNPAY; merchant production tách config riêng)
# Mapping: TMN Code → vnpay.tmnCode; Secret Key → vnpay.hashSecret; Pay URL TEST → vnpay.url
#
# returnUrl = URL backend nhận redirect sau khi user trả tiền (KHÔNG phải URL sandbox vnpayment.vn).
# Phải khớp @GetMapping("/vnpay-return") trên PaymentController: /payment/vnpay-return
# ---------------------------------------------------------------------------
vnpay.tmnCode=4L74HW0O
vnpay.hashSecret=7OXW4K2CTI7NOHE0KIV62E1SPH1USG2D
vnpay.url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.returnUrl=http://localhost:8081/payment/vnpay-return
# Để trống hoặc xóa dòng: cổng VNPAY cho chọn ATM / QR / ví…  Gán NCB chỉ khi muốn ép thẻ nội địa NCB (test nhanh).
vnpay.bankCode=

# Tuỳ chọn: IPN — VNPAY gọi server-to-server; localhost thường không reachable → cần HTTPS public (ngrok).
# Khi để trống, luồng vẫn test được qua returnUrl trên trình duyệt.
# vnpay.ipnUrl=https://YOUR_SUBDOMAIN.ngrok-free.app/payment/vnpay-ipn

# ---------------------------------------------------------------------------
# Tuỳ chọn: không tự tạo tin demo "Trek Emonda…" sau khi xóa hết listings (TRUNCATE)
# ---------------------------------------------------------------------------
# app.seed-demo-listing=false

# ---------------------------------------------------------------------------
# Tuỳ chọn: CORS thêm origin (phẩy)
# ---------------------------------------------------------------------------
# app.cors.extra-origins=http://localhost:3000
